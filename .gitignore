# ==========================================
# Visual Studio / C++ .gitignore
# ==========================================

# --- Пользовательские настройки Visual Studio ---
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.rsuser

# --- Результаты сборки (Build output) ---
[Dd]ebug/
[Rr]elease/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Oo]ut/
[Ll]og/
[Ll]ogs/

# --- Специфичные для C++ файлы (объектные, библиотеки, исполняемые) ---
*.obj
*.o
*.lo
*.slo
*.pch
*.gch
*.ilk
*.pdb
*.idb
*.exp
*.lib
*.a
*.la
*.lai
*.dll
*.so
*.dylib
*.exe
*.out
*.app

# --- Кэш Visual C++ (IntelliSense, базы данных) ---
ipch/
*.aps
*.ncb
*.opendb
*.opensdf
*.sdf
*.cachefile
*.VC.db
*.VC.VC.opendb

# --- Результаты тестов ---
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.VisualState.xml
TestResult.xml

# --- Профилировщик и отладка ---
*.psess
*.vsp
*.vspx
*.sap
*.e2e

# --- NuGet (если используется) ---
*.nupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/

# --- ReSharper / Rider (если используется) ---
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user
.idea/

# --- Прочее (временные файлы, логи, кэш) ---
*~
*.tmp
*.tmp_proj
*.log
*.tlog
*.vspscc
*.vssscc
.builds
*.pidb
*.svclog
*.scc
*.[Cc]ache
!?*.[Cc]ache/